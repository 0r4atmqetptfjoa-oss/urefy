{
  "output": {
    "filePath": "urefy-2-frontend-a-m.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "git": {
      "sortByChanges": false
    }
  },
  "include": [
    "packages/client-ui/index.html",
    "packages/client-ui/admin.html",
    "packages/client-ui/vite.config.ts",
    "packages/client-ui/src/controllers/**",
    "packages/client-ui/src/profile/**",
    "packages/client-ui/src/ui/**",
    "packages/client-ui/src/i18n/types.ts",
    "packages/client-ui/src/i18n/locales/index.ts",
    "packages/client-ui/src/i18n/locales/en.ts",
    "packages/client-ui/src/i18n/locales/ro.ts",
    "packages/client-ui/src/[a-m]*.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/**",
      "docs/**",
      "packages/client-ui/src/profile/seed-profiles-data.ts",
      "packages/client-ui/src/profile/production-profiles-data.ts",
      "**/*.png",
      "**/*.svg",
      "**/*.ico"
    ]
  }
}