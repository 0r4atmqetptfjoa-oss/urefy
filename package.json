{
  "name": "aetheris-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Aetheris - Sovereign Zero-Knowledge Hybrid Communication & Archival Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build --workspaces --if-present && tsc --noEmit --project packages/client-ui/tsconfig.json",
    "server": "npm run start --workspace=packages/server-edge",
    "client": "npm run dev --workspace=packages/client-ui",
    "daemon": "npm run start --workspace=packages/daemon-archivist"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  },
  "supportedArchitectures": {
    "os": ["current", "linux", "darwin"],
    "cpu": ["current", "x64", "arm64"]
  }
}
