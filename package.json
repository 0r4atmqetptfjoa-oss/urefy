{
  "name": "aetheris-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Aetheris - Sovereign Zero-Knowledge Hybrid Communication & Archival Platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck",
    "typecheck": "npm run build --workspaces --if-present && tsc --noEmit --project packages/client-ui/tsconfig.json",
    "server": "npm run start --workspace=packages/server-edge",
    "client": "npm run dev --workspace=packages/client-ui",
    "daemon": "npm run start --workspace=packages/daemon-archivist",
    "audit:production": "npm run audit:production --workspace=packages/client-ui",
    "audit:ux": "npm run audit:ux --workspace=packages/client-ui",
    "pack:clean": "git archive --format=zip HEAD -o aetheris-clean.zip"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "supportedArchitectures": {
    "os": [
      "current",
      "linux",
      "darwin"
    ],
    "cpu": [
      "current",
      "x64",
      "arm64"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1",
    "@rollup/rollup-linux-x64-musl": "^4.63.1"
  }
}
