{
  "output": {
    "filePath": "urefy-1-backend-crypto-api.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "git": {
      "sortByChanges": false
    }
  },
  "include": [
    "package.json",
    "tsconfig.base.json",
    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "packages/*/wrangler.toml",
    "packages/core-crypto/src/**",
    "packages/vault-engine/src/**",
    "packages/server-edge/src/**",
    "packages/daemon-archivist/src/**",
    "packages/client-ui/functions/**",
    "packages/client-ui/migrations/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/**",
      "docs/**",
      "scripts/**",
      "packages/core-crypto/src/bip39-wordlist.ts",
      "**/*.png",
      "**/*.svg",
      "**/*.ico"
    ]
  }
}