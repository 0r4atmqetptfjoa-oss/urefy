{
  "name": "@aetheris/client-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build && npx wrangler pages functions build functions --outdir dist --compatibility-flags=nodejs_compat && tsx scripts/post-build.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "i18n-audit": "tsx scripts/i18n-audit.ts",
    "audit:production": "tsx scripts/audit-production.ts",
    "audit:ux": "tsx scripts/audit-ux.ts"
  },
  "dependencies": {
    "@aetheris/core-crypto": "*",
    "@aetheris/vault-engine": "*",
    "lucide": "^0.475.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.34.8",
    "@rollup/rollup-linux-x64-musl": "^4.34.8"
  }
}

