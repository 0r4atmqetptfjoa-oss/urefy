{
  "name": "@aetheris/client-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build && wrangler pages functions build functions --outdir dist --compatibility-flags=nodejs_compat && tsx scripts/post-build.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "local:db": "wrangler d1 execute aetheris-db --local --persist-to .wrangler-product-qa --file functions/schema.sql",
    "preview:full": "wrangler pages dev dist --persist-to .wrangler-product-qa --ip 127.0.0.1 --port 3011 --binding CORS_ALLOWED_ORIGINS=http://127.0.0.1:3011",
    "i18n-audit": "tsx scripts/i18n-audit.ts",
    "audit:production": "tsx scripts/audit-production.ts",
    "audit:ux": "tsx scripts/audit-ux.ts"
  },
  "dependencies": {
    "@aetheris/core-crypto": "*",
    "@aetheris/vault-engine": "*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "aws-rum-web": "^3.2.1",
    "ethers": "^6.17.0",
    "lucide": "^1.42.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
