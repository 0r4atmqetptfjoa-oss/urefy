{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aetheris",
  "version": "1.0.0",
  "identifier": "app.aetheris.sovereign",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aetheris Sovereign",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ws: http: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
