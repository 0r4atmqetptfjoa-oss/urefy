{
  "name": "UREfy — Unified Relay Enclave Framework for You",
  "short_name": "UREfy",
  "description": "Private communication, sovereign identity and verified knowledge unified for you",
  "id": "/",
  "start_url": "/#feed",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#090a0f",
  "theme_color": "#090a0f",
  "orientation": "any",
  "scope": "/",
  "lang": "en-US",
  "categories": ["social", "productivity", "security"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.ico",
      "sizes": "48x48",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Feed",
      "url": "/#feed"
    },
    {
      "name": "Messages",
      "url": "/#messages"
    },
    {
      "name": "Vault",
      "url": "/#vault"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "UREfy desktop workspace"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "UREfy mobile interface"
    }
  ],
  "prefer_related_applications": false,
  "handle_links": "preferred"
}
